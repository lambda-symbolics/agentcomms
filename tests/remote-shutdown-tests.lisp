(in-package #:agentcomms)

;;;; -- Bounded Shutdown Race Fixtures --

(-> test-remote-task (function) list)
(defun test-remote-task (function)
  "Run FUNCTION on a thread, capturing its result or error and signaling completion."
  (let* ((done   (bt2:make-semaphore))
         (thread (bt2:make-thread
                  (lambda ()
                    (unwind-protect
                         (handler-case (list ':value (funcall function))
                           (error (condition)
                             (list ':error condition)))
                      (bt2:signal-semaphore done)))
                  :name "agentcomms shutdown test")))
    (list thread done)))

(-> test-remote-finish (list) t)
(defun test-remote-finish (task)
  "Wait at most five seconds for TASK and propagate its error, or return its value."
  (test-assert (bt2:wait-on-semaphore (second task) :timeout 5))
  (let ((result (bt2:join-thread (first task))))
    (when (eq (first result) ':error)
      (error (second result)))
    (second result)))

(-> test-remote-wait-stopped (acp-remote-server) null)
(defun test-remote-wait-stopped (server)
  "Wait at most five seconds for SERVER to publish its stopped state."
  (bt2:with-lock-held ((acp-remote-server--lock server))
    (loop with deadline = (+ (get-internal-real-time) (* 5 internal-time-units-per-second))
          until (acp-remote-server--stopped-p server)
          do (test-assert (< (get-internal-real-time) deadline))
             (bt2:condition-wait (acp-remote-server--condition server)
                                (acp-remote-server--lock server) :timeout 0.1)))
  nil)

(-> test-remote-assert-stopped (acp-remote-server) null)
(defun test-remote-assert-stopped (server)
  "Check that shutdown has drained every admitted socket, connection, and thread."
  (test-equal nil (acp-remote-server--sockets server))
  (test-equal 0 (hash-table-count (acp-remote-server--connections server)))
  (test-assert (notany #'bt2:thread-alive-p
                         (append (acp-remote-server--threads server)
                                 (acp-remote-server--workers server))))
  nil)

(-> test-remote-cleanup (acp-remote-server list) null)
(defun test-remote-cleanup (server tasks)
  "Stop SERVER and bound cleanup of its threads and test TASKS, even after a failed assertion."
  (let* ((stop    (test-remote-task (lambda () (acp-remote-server-stop server))))
         (threads (append (mapcar #'first (cons stop tasks))
                          (acp-remote-server--threads server)
                          (acp-remote-server--workers server))))
    (unless (test-wait-until (lambda () (notany #'bt2:thread-alive-p threads)))
      (dolist (thread threads)
        (when (bt2:thread-alive-p thread)
          (bt2:destroy-thread thread))))
    (dolist (thread threads)
      (bt2:join-thread thread)))
  nil)


;;;; -- Shutdown Admission Tests --

(define-test remote-stop-rejects-late-accepted-socket
  (let ((original (symbol-function 'tcp-accept))
        (accepted (bt2:make-semaphore))
        (release  (bt2:make-semaphore))
        (server   nil)
        (peer     nil)
        (socket   nil)
        (stop     nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'tcp-accept)
                 (lambda (&rest arguments)
                   (setf socket (apply original arguments))
                   (bt2:signal-semaphore accepted)
                   (test-assert (bt2:wait-on-semaphore release :timeout 5))
                   socket))
           (setf server (acp-remote-server-start (lambda (channel) (channel-close channel)) :port 0)
                 peer (tcp-connect "127.0.0.1" (acp-remote-server-port server)))
           (test-assert (bt2:wait-on-semaphore accepted :timeout 5))
           (setf stop (test-remote-task (lambda () (acp-remote-server-stop server))))
           (test-remote-wait-stopped server)
           (bt2:signal-semaphore release)
           ;; The peer sends nothing and is still open when stop returns.
           (test-remote-finish stop)
           (test-remote-assert-stopped server)
           (test-assert (wait-for-input peer :timeout 1 :ready-only t))
           (test-equal ':eof (read-byte (tcp-stream peer) nil ':eof)))
      (setf (symbol-function 'tcp-accept) original)
      (bt2:signal-semaphore release)
      (when peer (close-tcp peer))
      (when socket (remote--shut-down-socket socket))
      (when server (test-remote-cleanup server (when stop (list stop)))))))

(define-test remote-stop-rejects-late-http-connection
  (let ((original (symbol-function 'make-acp-channel-pair))
        (created  (bt2:make-semaphore))
        (release  (bt2:make-semaphore))
        (channels nil)
        (open     nil)
        (stop     nil)
        (server   (acp-remote-server-start (lambda (channel) (channel-close channel)) :port 0)))
    (unwind-protect
         (progn
           (setf (symbol-function 'make-acp-channel-pair)
                 (lambda (&rest arguments)
                   (setf channels (multiple-value-list (apply original arguments)))
                   (bt2:signal-semaphore created)
                   (test-assert (bt2:wait-on-semaphore release :timeout 5))
                   (values-list channels)))
           (setf open (test-remote-task (lambda () (remote--open-connection server))))
           (test-assert (bt2:wait-on-semaphore created :timeout 5))
           (setf stop (test-remote-task (lambda () (acp-remote-server-stop server))))
           (test-remote-finish stop)
           (bt2:signal-semaphore release)
           (test-equal nil (test-remote-finish open))
           (test-assert (notany #'channel-open-p channels))
           (test-remote-assert-stopped server))
      (setf (symbol-function 'make-acp-channel-pair) original)
      (bt2:signal-semaphore release)
      (dolist (channel channels) (channel-close channel))
      (test-remote-cleanup server (remove nil (list open stop))))))

(define-test remote-stop-waits-for-http-worker-admission
  (let ((original (symbol-function 'remote--spawn))
        (paused   (bt2:make-semaphore))
        (release  (bt2:make-semaphore))
        (stopping (bt2:make-semaphore))
        (calls    0)
        (open     nil)
        (stop     nil)
        (server   (acp-remote-server-start
                   (lambda (channel)
                     (unwind-protect (channel-read-message channel)
                       (channel-close channel)))
                   :port 0)))
    (unwind-protect
         (progn
           (setf (symbol-function 'remote--spawn)
                 (lambda (server function name)
                   (when (= (incf calls) 2)
                     (bt2:signal-semaphore paused)
                     (test-assert (bt2:wait-on-semaphore release :timeout 5)))
                   (funcall original server function name)))
           (setf open (test-remote-task (lambda () (remote--open-connection server))))
           (test-assert (bt2:wait-on-semaphore paused :timeout 5))
           (setf stop (test-remote-task
                       (lambda ()
                         (bt2:signal-semaphore stopping)
                         (acp-remote-server-stop server))))
           (test-assert (bt2:wait-on-semaphore stopping :timeout 5))
           (test-assert (not (bt2:wait-on-semaphore (second stop) :timeout 0.1)))
           (bt2:signal-semaphore release)
           (let ((connection (test-remote-finish open)))
             (test-assert connection)
             (test-remote-finish stop)
             (test-assert (not (channel-open-p (acp-remote-connection--channel connection)))))
           (test-remote-assert-stopped server))
      (setf (symbol-function 'remote--spawn) original)
      (bt2:signal-semaphore release)
      (test-remote-cleanup server (remove nil (list open stop))))))

(define-test remote-http-worker-start-failure-closes-channels
  (let ((original      (symbol-function 'remote--spawn))
        (calls         0)
        (agent-channel nil)
        (served        (bt2:make-semaphore))
        (failure       (make-condition 'simple-error :format-control "Injected pump startup failure."))
        (stop          nil)
        (server        nil))
    (setf server (acp-remote-server-start
                  (lambda (channel)
                    (setf agent-channel channel)
                    (bt2:signal-semaphore served)
                    (channel-read-message channel))
                  :port 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'remote--spawn)
                 (lambda (server function name)
                   (when (= (incf calls) 2)
                     (error failure))
                   (funcall original server function name)))
           (test-assert (eq failure (handler-case (remote--open-connection server)
                                     (error (condition)
                                       condition))))
           (test-assert (bt2:wait-on-semaphore served :timeout 5))
           (setf stop (test-remote-task (lambda () (acp-remote-server-stop server))))
           (test-remote-finish stop)
           (test-assert (not (channel-open-p agent-channel)))
           (test-assert (not (channel-open-p (acp-pipe-channel-peer agent-channel))))
           (test-remote-assert-stopped server))
      (setf (symbol-function 'remote--spawn) original)
      (test-remote-cleanup server (when stop (list stop))))))

(define-test remote-reaper-notices-stop-before-first-wait
  (let ((original (symbol-function 'remote--reap-loop))
        (started  (bt2:make-semaphore))
        (release  (bt2:make-semaphore))
        (server   nil)
        (stop     nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'remote--reap-loop)
                 (lambda (server)
                   (bt2:signal-semaphore started)
                   (test-assert (bt2:wait-on-semaphore release :timeout 5))
                   (funcall original server)))
           (setf server (acp-remote-server-start (lambda (channel) (channel-close channel)) :port 0))
           (test-assert (bt2:wait-on-semaphore started :timeout 5))
           (setf stop (test-remote-task (lambda () (acp-remote-server-stop server))))
           (test-remote-wait-stopped server)
           (bt2:signal-semaphore release)
           (test-remote-finish stop)
           (test-remote-assert-stopped server))
      (setf (symbol-function 'remote--reap-loop) original)
      (bt2:signal-semaphore release)
      (when server (test-remote-cleanup server (when stop (list stop)))))))
